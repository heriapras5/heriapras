APP_NAME="Heri Project"
APP_ENV=local
APP_KEY=
# Wajib false di production agar stack trace tidak bocor ke pengunjung.
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# daily memutar file log harian (14 hari) agar disk tidak membengkak;
# single hanya cocok untuk development.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# debug di local, warning/error di production.
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=heri_project
DB_USERNAME=root
DB_PASSWORD=

# database praktis untuk local; redis disarankan di production agar
# session/cache/queue tidak berebut lock dengan data aplikasi di MySQL.
SESSION_DRIVER=database
# SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log untuk development (email hanya ditulis ke laravel.log);
# ganti ke smtp dengan kredensial asli di production agar notifikasi terkirim.
MAIL_MAILER=log
# MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Akun admin awal yang dibuat DatabaseSeeder. JANGAN commit nilai aslinya.
# Kosongkan ADMIN_PASSWORD saat seed pertama: seeder membuat password acak
# dan menampilkannya sekali di console — simpan, lalu isi ke .env.
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
